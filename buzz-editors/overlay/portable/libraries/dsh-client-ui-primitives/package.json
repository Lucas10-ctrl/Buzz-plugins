{
  "name": "@deepseek-ai/dsh-client-ui-primitives",
  "description": "Pure React atoms for the dsh web UI: controls, icons, markdown, and JSON inspectors (zero cordis)",
  "version": "0.1.7-rc.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-primitives"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "private": true,
  "dependencies": {
    "react": "19.2.8",
    "clsx": "2.1.1",
    "@deepseek-ai/dsh-util-workspace-path": "workspace:*",
    "react-dom": "19.2.8",
    "simple-icons": "16.31.0",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "shiki": "4.3.1",
    "@shikijs/langs": "4.3.1",
    "anser": "2.3.5",
    "diff": "9.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-factory-space": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "katex": "0.16.47"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  }
}
