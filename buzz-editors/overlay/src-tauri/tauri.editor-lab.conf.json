{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buzz Editor Lab",
  "identifier": "xyz.block.buzz.editorlab",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "buzz-editor-lab"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Buzz Editor Lab",
        "dragDropEnabled": false,
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 24,
          "y": 30
        },
        "minWidth": 480,
        "minHeight": 400,
        "backgroundThrottling": "disabled"
      }
    ]
  }
}
