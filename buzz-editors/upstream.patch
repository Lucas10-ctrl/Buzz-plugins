+  const h = mount();
+  const attach = h.commands().attachFiles;
+  const file = attachmentFile();
+  act(() =>
+    expect(attach?.([file])).toBe(
+      "Uploads are unavailable on this connection.",
+    ),
+  );
+  h.retarget({ channelId: "other" });
+  expect(attach?.([file])).toBe("The message can't be edited right now");
+  expect(h.messages.send).not.toHaveBeenCalled();
+});
